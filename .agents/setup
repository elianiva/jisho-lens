#!/usr/bin/env bash
# The Gradle build needs a JDK with a working trust store, and the Android SDK.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SDK_ROOT="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/android-sdk}}"
SDKMANAGER="$SDK_ROOT/cmdline-tools/latest/bin/sdkmanager"

# Images differ: some run as root and have no sudo at all.
as_root() {
    if [ "$(id -u)" -eq 0 ]; then
        "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo "$@"
    else
        echo "Need root or sudo to run: $*" >&2
        return 1
    fi
}

# Gradle runs on the JDK on PATH. Debian 13 (trixie) ships OpenJDK 21 and has no
# openjdk-17 package; Debian 12 (bookworm) ships 17. Install whichever apt has,
# newest first, so the same script works on both.
if ! command -v javac >/dev/null 2>&1; then
    as_root apt-get update -qq
    for package in openjdk-21-jdk-headless openjdk-17-jdk-headless; do
        if apt-cache show "$package" >/dev/null 2>&1; then
            as_root apt-get install -y -qq "$package"
            break
        fi
    done
    if ! command -v javac >/dev/null 2>&1; then
        echo "No JDK is installed and apt has no OpenJDK package for this distribution." >&2
        exit 1
    fi
fi

# :dictionary and :cli compile with a Java 17 toolchain. settings.gradle.kts adds
# the foojay resolver, so Gradle downloads that toolchain itself when the JDK
# above is newer. This script installs no second JDK.

# Docker Hardened Images ship /etc/ssl/certs without the .pem symlinks that
# ca-certificates-java reads, so installing a JDK builds no keystore. Java then
# has no trust anchors: every HTTPS connection fails with "the trustAnchors
# parameter must be non-empty", sdkmanager reports "IO exception while
# downloading manifest", and Gradle cannot fetch its distribution or its
# dependencies. Rebuild the store when it is missing or empty.
if ! keytool -list -cacerts -storepass changeit >/dev/null 2>&1; then
    echo "==> rebuilding the Java trust store"
    if ! dpkg -s ca-certificates-java >/dev/null 2>&1; then
        as_root apt-get update -qq
        as_root apt-get install -y -qq ca-certificates-java
    fi
    # -f regenerates /etc/ssl/certs, which is what the ca-certificates-java
    # hook turns into /etc/ssl/certs/java/cacerts.
    as_root update-ca-certificates -f >/dev/null
    if ! keytool -list -cacerts -storepass changeit >/dev/null 2>&1; then
        echo "Java has no usable trust store, so HTTPS downloads will fail." >&2
        exit 1
    fi
fi

# Fetch the command line tools once. A run that already has them keeps them.
if [ ! -x "$SDKMANAGER" ]; then
    mkdir -p "$SDK_ROOT/cmdline-tools"
    tmp="$(mktemp -d)"
    curl -fsSL "https://dl.google.com/android/repository/commandlinetools-linux-13114758_latest.zip" -o "$tmp/tools.zip"
    unzip -q -o "$tmp/tools.zip" -d "$SDK_ROOT/cmdline-tools"
    rm -rf "$tmp"
    if [ -d "$SDK_ROOT/cmdline-tools/cmdline-tools" ]; then
        rm -rf "$SDK_ROOT/cmdline-tools/latest"
        mv "$SDK_ROOT/cmdline-tools/cmdline-tools" "$SDK_ROOT/cmdline-tools/latest"
    fi
fi
if [ ! -x "$SDKMANAGER" ]; then
    echo "The Android command line tools did not unpack into $SDK_ROOT." >&2
    exit 1
fi

# Check each package, not just the platform: a setup that stopped halfway used
# to leave build-tools or platform-tools missing while the platform existed.
missing=()
[ -d "$SDK_ROOT/platforms/android-37.0" ] || missing+=("platforms;android-37.0")
[ -d "$SDK_ROOT/build-tools/36.0.0" ] || missing+=("build-tools;36.0.0")
[ -d "$SDK_ROOT/platform-tools" ] || missing+=("platform-tools")
if [ "${#missing[@]}" -gt 0 ]; then
    # Process substitution, not a pipe: sdkmanager stops reading once it has
    # every licence, and a pipe would leave `yes` killed by SIGPIPE, which
    # pipefail turns into a failed setup.
    "$SDKMANAGER" --sdk_root="$SDK_ROOT" --licenses >/dev/null < <(yes)
    "$SDKMANAGER" --sdk_root="$SDK_ROOT" "${missing[@]}" >/dev/null
fi

printf 'sdk.dir=%s\n' "$SDK_ROOT" > "$REPO_ROOT/local.properties"

# Android SDK plus a software-emulated Android 30 AVD. The emulator runs without
# KVM, so it is slow; the download is ~7 GB. Opt in per thread:
#   ANDROID_EMULATOR=1 bash .agents/setup
if [ "${ANDROID_EMULATOR:-0}" = "1" ]; then
    ANDROID_HOME="$SDK_ROOT" bash "$(dirname "$0")/android-emulator.sh" install
fi
